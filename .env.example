# ===============================================
# WHATSAPP AI AUTOMATION CONFIGURATION
# ===============================================

# 1. Google Gemini AI API Key (Free on https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Meta WhatsApp Cloud API Credentials (https://developers.facebook.com/)
WHATSAPP_TOKEN=your_permanent_meta_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v21.0

# 3. Custom Secret Webhook Verification Token (Apni marzi ka koi bhi secret word)
VERIFY_TOKEN=my_secret_verify_token_123
